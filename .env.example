# Copy this file to .env.local and fill in ONE of the two keys below.
# The app works fully without either (local search, timetable, and the
# offline quiz all work with zero configuration) — a key only unlocks the
# AI assistant, homework helper and resume builder.

# Option A — Anthropic (used first if both are set)
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option B — Google AI Studio / Gemini (completely free tier)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — override the model if the default in lib/gemini.ts 404s later:
# GEMINI_MODEL=gemini-2.5-flash

# Never commit .env.local — it's already in .gitignore.
